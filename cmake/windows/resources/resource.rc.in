1 VERSIONINFO
 FILEVERSION ${PROJECT_VERSION_MAJOR},${PROJECT_VERSION_MINOR},${PROJECT_VERSION_PATCH},0
 PRODUCTVERSION ${PROJECT_VERSION_MAJOR},${PROJECT_VERSION_MINOR},${PROJECT_VERSION_PATCH},0
 FILEFLAGSMASK 0x0L
#ifdef _DEBUG
 FILEFLAGS 0x1L
#else
 FILEFLAGS 0x0L
#endif
 FILEOS 0x40004L
 FILETYPE 0x2L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Vertical Shorts Plugin Contributors"
            VALUE "FileDescription", "Professional Vertical Streaming Plugin for OBS Studio"
            VALUE "FileVersion", "${PROJECT_VERSION}"
            VALUE "InternalName", "obs-shorts-vertical"
            VALUE "LegalCopyright", "(C) ${CURRENT_YEAR} Vertical Shorts Plugin Contributors"
            VALUE "OriginalFilename", "obs-shorts-vertical.dll"
            VALUE "ProductName", "Vertical Shorts Plugin"
            VALUE "ProductVersion", "${PROJECT_VERSION}"
            VALUE "Comments", "Open-source OBS Studio plugin. Built ${PLUGIN_BUILD_TIMESTAMP}. Source: https://github.com/PFS2689/verticalshorts"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
